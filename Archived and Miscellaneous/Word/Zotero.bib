@article{jeffreys_tests_1935,
	title = {Some tests of significance, treated by the theory of probability},
	volume = {31},
	url = {https://www.cambridge.org/core/journals/mathematical-proceedings-of-the-cambridge-philosophical-society/article/abs/some-tests-of-significance-treated-by-the-theory-of-probability/9CABF59267F2A34F97E3577980AF491E},
